# Browser-visible API base URL. Workers deployments use the same-origin `/api`
# route so auth cookies stay scoped to the dashboard host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18173

# Server-only target used when NEXT_PUBLIC_API_BASE_URL=/api is handled by the
# Next.js route handler. Set the production value as a Worker secret as well as
# in the ignored build environment.
# API_PROXY_TARGET=http://127.0.0.1:18173

# Cloudflare Access service token forwarded only by the server-side /api proxy.
# Configure both values as Worker secrets; never expose them as NEXT_PUBLIC_*.
# CF_ACCESS_CLIENT_ID=""
# CF_ACCESS_CLIENT_SECRET=""

# Canonical public origin for SEO (metadataBase, canonical URLs, Open Graph
# / Twitter cards, hreflang alternates). Required for production builds. No
# trailing slash. Local development falls back to http://localhost:19341.
NEXT_PUBLIC_SITE_URL=http://localhost:19341
