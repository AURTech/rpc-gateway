{
  "name": "rpc-gateway-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.9.0"
  },
  "scripts": {
    "dev": "next dev --port 19341",
    "start": "next start --port 19341",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome check . && node scripts/lint-no-arbitrary-tw.mjs",
    "lint:fix": "biome check --write . && node scripts/lint-no-arbitrary-tw.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome ci . && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build:worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doctor": "pnpm dlx react-doctor@latest --verbose",
    "doctor:score": "pnpm dlx react-doctor@latest --score",
    "doctor:diff": "pnpm dlx react-doctor@latest --verbose --diff main"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/maple-mono": "^5.2.6",
    "@opennextjs/cloudflare": "1.20.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.0",
    "next": "16.2.11",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.113.0"
  }
}
