# Local development template. Production copies must replace every deployment
# URL, origin, database, Redis, and secret value.

# App runtime
APP_ENV="dev"
PROJECT_NAME="rpc-gateway-api"
HOST="127.0.0.1"
PORT=18173
WORKERS=1
RELOAD=false
DEBUG=false

# Public Gateway addressing. The API base URL is used for generated access
# points; the Gateway base domain is also used to match incoming public hosts.
PUBLIC_RPC_API_BASE_URL="http://127.0.0.1:18173"
PUBLIC_RPC_GATEWAY_BASE_DOMAIN=""

# Containers use a read-only root filesystem. Leave LOG_PATH unset and collect stderr.
# LOG_PATH="/var/log/rpc-gateway/api.log"

# The fastlog watcher exports file logs over OTLP. OTEL_AUTH is optional Basic auth.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=""
OTEL_AUTH=

# Browser, request middleware, and protocol forwarding
CORS_ORIGINS='["http://127.0.0.1:19341","http://localhost:19341"]'
# RPC_HTTP_MAX_REQUEST_BYTES=1048576
# RPC_HTTP_BODY_READ_TIMEOUT_SECONDS=15
# JSONRPC_FORWARDING_MAX_ATTEMPTS=3
# HTTP_API_FORWARDING_MAX_ATTEMPTS=3
# RUNTIME_CIRCUIT_WINDOW_SECONDS=30
# RUNTIME_CIRCUIT_WINDOW_BUCKET_SECONDS=5
# RUNTIME_CIRCUIT_MIN_SAMPLES=20
# RUNTIME_CIRCUIT_FAILURE_RATE=0.5
# RUNTIME_CIRCUIT_HARD_FAILURE_THRESHOLD=5
# RUNTIME_CIRCUIT_OPEN_SECONDS=30
# RUNTIME_CIRCUIT_MAX_OPEN_SECONDS=300
# RUNTIME_CIRCUIT_RECOVERY_SUCCESSES=2
# RUNTIME_CIRCUIT_PROBE_SECONDS=30
# RUNTIME_CIRCUIT_THROTTLE_SECONDS=2
# RUNTIME_CIRCUIT_THROTTLE_MAX_SECONDS=30
# RUNTIME_CIRCUIT_TRACE_METHOD_PREFIXES='["debug_","trace_"]'

# Public JSON-RPC Admission
# Backend defaults to redis. Local state resets on restart and requires one worker and one replica.
# PUBLIC_JSONRPC_RATE_LIMIT_BACKEND=redis
# PUBLIC_JSONRPC_RATE_LIMIT_POLICY_REFRESH_SECONDS=5
# PUBLIC_JSONRPC_RATE_LIMIT_EXPECTED_REPLICAS=1
# PUBLIC_JSONRPC_RATE_LIMIT_SHADOW_MAX_PENDING=4096
# PUBLIC_JSONRPC_RATE_LIMIT_SHADOW_WORKERS=16
# PUBLIC_JSONRPC_RATE_LIMIT_SHADOW_REDIS_TIMEOUT_MS=10
# PUBLIC_JSONRPC_RATE_LIMIT_SHADOW_SHUTDOWN_DRAIN_SECONDS=1

# Public HTTP API Admission
# Backend defaults to redis. Local state resets on restart and requires one worker and one replica.
# PUBLIC_HTTP_API_RATE_LIMIT_BACKEND=redis
# PUBLIC_HTTP_API_RATE_LIMIT_POLICY_REFRESH_SECONDS=5
# PUBLIC_HTTP_API_RATE_LIMIT_EXPECTED_REPLICAS=1
# PUBLIC_HTTP_API_RATE_LIMIT_SHADOW_MAX_PENDING=4096
# PUBLIC_HTTP_API_RATE_LIMIT_SHADOW_WORKERS=16
# PUBLIC_HTTP_API_RATE_LIMIT_SHADOW_REDIS_TIMEOUT_MS=10
# PUBLIC_HTTP_API_RATE_LIMIT_SHADOW_SHUTDOWN_DRAIN_SECONDS=1

# Shared System Cache. Admin requests may publish reusable results.
# SYSTEM_CACHE_ENABLED=true
# SYSTEM_CACHE_REDIS_TTL_MS=250
# Overriding retention requires every supported chain exactly once.
# SYSTEM_CACHE_POSTGRES_RETENTION_SECONDS_BY_CHAIN='{"ethereum":7200,"polygon":1200,"bsc":600,"arbitrum":300,"optimism":1200,"base":1200,"solana":1500,"bitcoin":86400,"litecoin":21600,"tron":1200}'
# SYSTEM_CACHE_POSTGRES_CLEANUP_BATCH_MAX_BYTES=33554432

# PostgreSQL pools use the same ORM_URL but reserve independent application-side capacity.
# ORM_POOL_MIN_SIZE=1
# ORM_POOL_MAX_SIZE=5
# SYSTEM_CACHE_POSTGRES_POOL_MIN_SIZE=1
# SYSTEM_CACHE_POSTGRES_POOL_MAX_SIZE=8
# SYSTEM_CACHE_COORDINATION_POOL_MIN_SIZE=1
# SYSTEM_CACHE_COORDINATION_POOL_MAX_SIZE=8

# Runtime State and manual Endpoint health-check bounds
# RUNTIME_HEALTH_DISPATCHER_MAX_BATCHES=4096
# RUNTIME_HEALTH_DISPATCHER_MAX_WAITERS=2048
# RUNTIME_HEALTH_DISPATCHER_MAX_WAITERS_PER_BATCH=64
# RUNTIME_HEALTH_DISPATCHER_RECORD_TIMEOUT_MS=2000
# RUNTIME_HEALTH_DISPATCHER_COALESCE_MS=5
# RUNTIME_HEALTH_DISPATCHER_SHUTDOWN_DRAIN_SECONDS=5
# RUNTIME_TIP_DISPATCHER_MAX_ITEMS=1024
# RUNTIME_TIP_DISPATCHER_SHUTDOWN_DRAIN_SECONDS=5
# ENDPOINT_HEALTH_CHECK_TIMEOUT_SECONDS=5
# ENDPOINT_HEALTH_CHECK_MAX_RESPONSE_BYTES=1048576

# Database and Redis
ORM_URL="postgres://rpc_gateway:rpc_gateway@127.0.0.1:5432/rpc_gateway"
REDIS_URL="redis://localhost:6379/0"
# REDIS_CONNECT_TIMEOUT_SECONDS=1
# REDIS_SOCKET_TIMEOUT_SECONDS=5

# Usage
# USAGE_STREAM_MAX_LENGTH=250000
# USAGE_HOURLY_RETENTION_MONTHS=3
# USAGE_FINE_RETENTION_HOURS=48
# USAGE_ASYNC_ROLLUP_CUTOVER_AT=2026-08-01T00:00:00Z

# TaskIQ Redis Stream
TASKIQ_RETRY_COUNT=3
TASKIQ_RESULT_TTL_SECONDS=3600
TASKIQ_STREAM_MAXLEN=100000
TASKIQ_UNACKNOWLEDGED_LOCK_TIMEOUT_SECONDS=600

# Tests
# TEST_ORM_URL="postgres://rpc_gateway:rpc_gateway_test@127.0.0.1:5432/rpc_gateway_test"
# TEST_REDIS_URL="redis://localhost:6379/15"

# Shared outbound HTTP client and target policy
OUTBOUND_HTTP_MAX_CONNECTIONS=100
OUTBOUND_HTTP_MAX_KEEPALIVE=50
# Only explicit RFC 1918 or IPv6 unique-local CIDRs are accepted here.
OUTBOUND_PRIVATE_NETWORK_CIDRS='[]'

# Authentication
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
AURPAY_OIDC_ISSUER=""
AURPAY_OIDC_CLIENT_ID=""
AURPAY_OIDC_CLIENT_SECRET=""
AURPAY_OIDC_REDIRECT_URI=""
FRONTEND_AUTH_CALLBACK_URL="http://localhost:19341/en/auth/callback"
ADMIN_ALLOWED_EMAILS='[]'
AUTH_SESSION_SECRET="" # openssl rand -base64 32
AUTH_PAT_HASH_SECRET="" # openssl rand -base64 32
# AUTH_COOKIE_SAMESITE="none"
# AUTH_COOKIE_SECURE=true
AUTH_PASSWORD_MAX_CONCURRENCY=4

# App/API keys. Replace this placeholder before starting any process.
APP_API_KEY_MASTER_KEY="" # openssl rand -base64 32

# Endpoint URLs/auth secrets and Provider credentials use independent
# encryption purposes within this versioned resource keyring.
ENDPOINT_ACTIVE_KEY_VERSION="v1"
ENDPOINT_KEYRING='{}' # e.g. {"v1":"<openssl rand -base64 32>"}
